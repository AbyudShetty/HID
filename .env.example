# Copy to .env and fill in. Never commit .env (plan §2.2).
# Long random strings, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
KIOSK_TOKEN=change-me-kiosk
OPERATOR_TOKEN=change-me-operator

# local = SQLite + filesystem; aws = DynamoDB + S3 (plan F-10, implemented in M6)
STORAGE_BACKEND=local
DATA_DIR=./data
MODELS_DIR=./models
AWS_REGION=

# Save frames of non-collect sessions (demo/rehearsal with consent only). Collect sessions always save.
AUDIT_SAVE_FRAMES=false

# Comma-separated origins allowed by CORS (the kiosk dev server by default)
CORS_ORIGINS=http://localhost:5173
